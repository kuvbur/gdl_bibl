
define style  "textstyle"  "ISOCPEUR", 3, 5, 0
SET STYLE "textstyle"

PAPER_TO_MODEL = GLOB_SCALE / 1000
lax = 15*PAPER_TO_MODEL
htxt = 0.1*PAPER_TO_MODEL
hotspot 0,0,0
text2 0,0,txt
TEXT htxt, 0, txt
!!!!Z
pen 6
hotspot 0,0,lax
lin_ 0,0,0, 0,0,lax
HOTLINE 0,0,0, 0,0,lax,1
addz lax
TEXT htxt, 0, "Z"+txt
del 1

!!!Y
pen 20
lin_ 0,0,0, 0,lax,0
line2 0,0,0,lax
hotline2 0,0,0,lax
hotspot 0,lax,0
HOTLINE  0,0,0, 0,lax,0,2
text2 0,lax,"Y"+txt
addy lax
TEXT htxt, 0, "Y"+txt
del 1
!!!X
pen 4
lin_ 0,0,0, lax,0,0
line2 0,0,lax,0
hotline2 0,0,lax,0
hotspot lax,0,0
HOTLINE  0,0,0, lax,0,0,3
text2 lax,0,"X"+txt
addx lax
TEXT htxt, 0, "X"+txt
del 1
pen gs_cont_pen
