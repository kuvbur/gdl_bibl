
if not(haskey(profile_data.set.path)) and typesheet = VERT_SHEET then end
if not(haskey(profile_data.set.start)) then end
if vardim1(profile_data.set.start)<EPS then end
if haskey(profile_data.set.is3d) then
	if not(profile_data.set.is3d) then end
endif

if GLOB_PREVIEW_MODE=1 or GLOB_PREVIEW_MODE=2 or GLOB_FEEDBACK_MODE=1 then
	gs_resol = 3
	det_lvl_3d = 1
	gs_shadow=0
	cutplane_enable = 0
else
	if GLOB_SEO_TOOL_MODE = 1 then
		gs_resol = 9
		show_empty = 0
		gs_shadow=0
		cutplane_enable = 0
	else
		if gs_resol<10 then gs_resol=12
	endif
endif

if show_mvo_proj=SHOW_PROJECT_BYMVO then
	show_mvo_proj = SHOW_PROJECT_NO
	success = LIBRARYGLOBAL ("Libraryflobals-km", "show_mvo_proj", show_mvo_proj)
	if show_mvo_proj then
		use_mvo_h = 0 : success = LIBRARYGLOBAL ("Libraryflobals-km", "use_mvo_h", use_mvo_h)
		if use_mvo_h then
			success = LIBRARYGLOBAL ("Libraryflobals-km", "t_proj_down", t_proj_down)
			success = LIBRARYGLOBAL ("Libraryflobals-km", "t_proj_up", t_proj_up)
			success = LIBRARYGLOBAL ("Libraryflobals-km", "h_proj_down", h_proj_down)
			success = LIBRARYGLOBAL ("Libraryflobals-km", "h_proj_up", h_proj_up)
			success = LIBRARYGLOBAL ("Libraryflobals-km", "is_show_lower", is_show_lower)
			success = LIBRARYGLOBAL ("Libraryflobals-km", "is_show_upper", is_show_upper)
		endif
	endif
endif

If GLOB_VIEW_TYPE = 2 and cutplane_enable and show_mvo_proj THEN
	if t_proj_down="Низ элемента" and t_proj_up="Верх элемента" then
		cutplane_enable = 0
	else
		show_axsis = 0
		show_line = 0
	
		if t_proj_down = "Низ элемента" then h_proj_down = -2
		if t_proj_down = "Низ диапазона этажа" then h_proj_down = GLOB_CUTPLANES_INFO[3] + GLOB_CSTORY_ELEV - GLOB_HSTORY_ELEV
		if t_proj_down = "П. сечения этажа" then h_proj_down = GLOB_CUTPLANES_INFO[1] + GLOB_CSTORY_ELEV - GLOB_HSTORY_ELEV
	
		if t_proj_up = "Верх элемента" then h_proj_up = 2
		if t_proj_up = "Верх диапазона этажа" then h_proj_up = GLOB_CUTPLANES_INFO[2] + GLOB_CSTORY_ELEV - GLOB_HSTORY_ELEV
		if t_proj_up = "П. сечения этажа" then h_proj_up = GLOB_CUTPLANES_INFO[1] + GLOB_CSTORY_ELEV - GLOB_HSTORY_ELEV
	
		if n_part_show = -1 then !Ниже сечения
			pen gs_cont_pen_down
			fill gs_fill_type_down
			line_type gs_line_type_down
			SECT_ATTRS gs_fill_type_down, gs_back_pen_down, gs_fill_pen_down, gs_cont_pen_down, gs_line_type_down
			addz h_proj_down
			CUTPLANE 0
			del 1
			cutplane_enable = 1
		endif
		if n_part_show = 0 then !В сечении
			addz h_proj_up
			CUTPLANE 0
			del 1
			if t_proj_down <> "Низ элемента" then 
				addz h_proj_down
				mulz -1
				CUTPLANE 0
				del 2
				cutplane_enable = 2
			endif
		endif
		if n_part_show = 1 then !Выше сечения
			pen gs_cont_pen_up
			fill gs_fill_type_up
			line_type gs_line_type_up
			SECT_ATTRS gs_fill_type_up, gs_back_pen_up, gs_fill_pen_up, gs_cont_pen_up, gs_line_type_up
			addz h_proj_up
			mulz -1
			CUTPLANE 0
			del 2
			cutplane_enable = 1
		endif
	endif
endIf


gosub "set_show_3d"
if not(show) or det_lvl_3d=0 then end
gosub "get_mat"
gosub "set_mat"
show_empty = 1
if show_only_axsis then det_lvl_3d = 1
if GLOB_PREVIEW_MODE=1 or GLOB_PREVIEW_MODE=2 or GLOB_FEEDBACK_MODE=1 then
	gs_resol = 3
	det_lvl_3d = 1
	gs_shadow=0
	DR_EPS = 0.1
else
	if GLOB_SEO_TOOL_MODE = 1 then
		gs_resol = 9
		show_empty = 0
		gs_shadow=0
		DR_EPS = 0.005
	else
		if gs_resol<10 then gs_resol=12
	endif
endif
!Группа с построенным по пути профилем
group "profile"
	if haskey(profile_data.set.coord) and typesheet = POLY_SHEET then
		if vardim1(profile_data.set.coord)>2 then
			tstart = NSP
			for i=1 to vardim1(profile_data.set.coord)
				put profile_data.set.coord[i].x+dx, profile_data.set.coord[i].y+dy*d, profile_data.set.coord[i].z
			next i
			tend = NSP
			n_form = (tend - tstart)/3
			PLANE n_form, get(n_form*3)
		endif
	else
		if haskey(profile_data.read._3d[det_lvl_3d].unput) then
			if typesheet = VERT_SHEET then
				gosub "set_form"
				gosub "set_path"
				mask = 1+2+16+32
				TUBE n_form, n_path, mask, get(n_form*3+n_path*4)
			endif
			if typesheet = GOR_SHEET then
				gosub "set_form"
				mask = 1+2+16+32
				EXTRUDE n_form, 0, 0, thickness*sgnth, mask, get(n_form*3)
			endif
		endif
	endif
endgroup

!Группа с формой листа (рифление, сталь на ребро)
has_forma = 0
group "forma"
	if typesheet = GOR_SHEET and det_lvl_3d = 2 and GLOB_VIEW_TYPE<>2 and GLOB_VIEW_TYPE<>9 and show_rifl_3d="Подробно" then
		if type_rifl = RIFL_PRESS then
			stpy = 40/1000
			stpx = 60/1000
			t = 3/1000
			tstart = NSP
			put 0,0,15
			put 0,thickness*sgnth,15
			put -t,thickness*sgnth,15
			put -t,0,15
			tend = NSP
			n_form = (tend - tstart)/3
			!Определяем максимальные координаты
			min_x = profile_data.read._3d[det_lvl_3d].unput[1].x : min_y = profile_data.read._3d[det_lvl_3d].unput[1].y
			max_x = min_x : max_y = min_y
			n_path = 0
			tstart = NSP
			for i=1 to vardim1(profile_data.read._3d[det_lvl_3d].unput)
				iStatus = profile_data.read._3d[det_lvl_3d].unput[i].s
				if (iStatus > 0) then iStatus = iStatus - iStatus % 100
				_d = 1 : if iStatus = 4000 or iStatus = 2000 then _d = 0
				max_x = max(max_x, profile_data.read._3d[det_lvl_3d].unput[i].x+dx*d)
				min_x = min(min_x, profile_data.read._3d[det_lvl_3d].unput[i].x+dx*d)
				max_y = max(max_y, profile_data.read._3d[det_lvl_3d].unput[i].y+dy*d)
				min_y = min(min_y, profile_data.read._3d[det_lvl_3d].unput[i].y+dy*d)
				put profile_data.read._3d[det_lvl_3d].unput[i].x+dx*d, profile_data.read._3d[det_lvl_3d].unput[i].y+dy*d, 0, 0
			next i
			for i=1 to min(4, vardim1(profile_data.read._3d[det_lvl_3d].unput))
				put profile_data.read._3d[det_lvl_3d].unput[i].x+dx*d, profile_data.read._3d[det_lvl_3d].unput[i].y+dy*d, 0, 0
			next i
			tend = NSP
			n_path = (tend - tstart)/4
			TUBE n_form, n_path, 1+2+16+32, get(n_form*3+n_path*4)
			for y=min_y to max_y step stpy
				PRISM 4, thickness, min_x, y, min_x, y+t, max_x, y+t, max_x, y
			next y
			addz thickness-thickness*0.7
			for x=min_x to max_x step stpx
				PRISM 4, thickness*0.7, x, min_y, x+t, min_y, x+t, max_y, x, max_y
			next x
			del 1
			has_forma = 1
		endif
	endif
endgroup

if has_forma = 1 then
	result=ISECTGROUP("profile", "forma")
else
	group "emp"
	endgroup
	result=ADDGROUP("profile", "emp")
	KILLGROUP "emp"
endif

KILLGROUP "profile"
KILLGROUP "forma"

n_trans = 0 !Количество именений СК
!Копируем группу сколько надо раз
for i=1 to vardim1(profile_data.set.start)

	!Смещение
	if haskey(profile_data.set.start[i].x) then
		addx profile_data.set.start[i].x
		n_trans = n_trans + 1
	endif
	if haskey(profile_data.set.start[i].y) then
		addy profile_data.set.start[i].y
		n_trans = n_trans + 1
	endif
	if haskey(profile_data.set.start[i].z) then
		addz profile_data.set.start[i].z
		n_trans = n_trans + 1
	endif

	!Поворот
	if haskey(profile_data.set.start[i].rx) then
		rotx profile_data.set.start[i].rx
		n_trans = n_trans + 1
	endif
	if haskey(profile_data.set.start[i].ry) then
		roty profile_data.set.start[i].ry
		n_trans = n_trans + 1
	endif
	if haskey(profile_data.set.start[i].rz) then
		rotz profile_data.set.start[i].rz
		n_trans = n_trans + 1
	endif

	!Отражение
	if haskey(profile_data.set.start[i].mx) then
		if abs(profile_data.set.start[i].mx)>EPS and profile_data.set.start[i].mx<EPS then
			mulx -1
			n_trans = n_trans + 1
		endif
	endif
	if haskey(profile_data.set.start[i].my) then
		if abs(profile_data.set.start[i].my)>EPS and profile_data.set.start[i].my<EPS then
			muly -1
			n_trans = n_trans + 1
		endif
	endif
	if haskey(profile_data.set.start[i].mz) then
		if abs(profile_data.set.start[i].mz)>EPS and profile_data.set.start[i].mz<EPS then
			mulz -1
			n_trans = n_trans + 1
		endif
	endif

	placegroup result

	if n_trans>0 then del n_trans
next i
KILLGROUP result
If cutplane_enable>0 THEN CUTEND
If cutplane_enable>1 THEN CUTEND
If cutplane_enable>2 THEN CUTEND

end
"set_form":
	tstart = NSP
	x1 = 0 : y1 = 0 : x2 = 0 : y2 = 0 : dr = 0 !Для вычисления расстояния между соседними точками
	for i=1 to vardim1(profile_data.read._3d[det_lvl_3d].unput)
		if not(haskey(profile_data.read._3d[det_lvl_3d].unput[i].s)) then profile_data.read._3d[det_lvl_3d].unput[i].s = 15
		iStatus = profile_data.read._3d[det_lvl_3d].unput[i].s
		if (iStatus > 0) then iStatus = iStatus - iStatus % 100
		_d = 1 : if iStatus = 4000 or iStatus = 2000 then _d = 0
		flag_add = 1
		if haskey(profile_data.read._3d[det_lvl_3d].unput[i].is_aprox) then
			!Для горизонтального листа на скруглениях нужно отключить рёбра
			if typesheet = GOR_SHEET then
				if profile_data.read._3d[det_lvl_3d].unput[i].is_aprox>EPS then profile_data.read._3d[det_lvl_3d].unput[i].s = 1 ! Делаем ребро скрытым
			endif
			!Проверяем, чтоб точки не были слишком близко (на расстоянии DR_EPS)
			x1 = profile_data.read._3d[det_lvl_3d].unput[i].x+dx*d : y1 = profile_data.read._3d[det_lvl_3d].unput[i].y+dy*d
			if i>1 and i<vardim1(profile_data.read._3d[det_lvl_3d].unput) then
				if haskey(profile_data.read._3d[det_lvl_3d].unput[i-1].is_aprox) and haskey(profile_data.read._3d[det_lvl_3d].unput[i+1].is_aprox) then
					! Если совпадение статусов точек - предыдущей и текущей
					if profile_data.read._3d[det_lvl_3d].unput[i-1].is_aprox=profile_data.read._3d[det_lvl_3d].unput[i].is_aprox and profile_data.read._3d[det_lvl_3d].unput[i+1].is_aprox=profile_data.read._3d[det_lvl_3d].unput[i].is_aprox then 
						dr = sqr((x2-x1)*(x2-x1) + (y2-y1)*(y2-y1))
						if abs(dr)<DR_EPS and abs(dr)>EPS then flag_add = 0
					endif
				endif
			endif
		endif
		if flag_add then
			x2 = x1 : y2 = y1
			put profile_data.read._3d[det_lvl_3d].unput[i].x+dx*d, profile_data.read._3d[det_lvl_3d].unput[i].y+dy*d, profile_data.read._3d[det_lvl_3d].unput[i].s
!			hotspot profile_data.read._3d[det_lvl_3d].unput[i].x+dx*d, profile_data.read._3d[det_lvl_3d].unput[i].y+dy*d, 0 !Для тестов
		endif
	next i
	tend = NSP
	n_form = (tend - tstart)/3
return

"set_path":
	n_path = 0
	tstart = NSP
	for i=1 to vardim1(profile_data.set.path)
		put profile_data.set.path[i].x, profile_data.set.path[i].y, profile_data.set.path[i].z, profile_data.set.path[i].a
!		hotspot profile_data.set.path[i].x, profile_data.set.path[i].y, profile_data.set.path[i].z !Для тестов
	next i
	tend = NSP
	n_path = (tend - tstart)/4
return

"set_mat":
	pen gs_cont_pen
	if tbmat>0 then
		BUILDING_MATERIAL tbmat
		SECT_ATTRS{2} gs_cont_pen, gs_line_type
	else
		SECT_ATTRS gs_fill_type_sec, gs_back_pen, gs_fill_pen, gs_sec_pen, gs_line_type
		fill gs_fill_type_sec
		line_type gs_line_type
	endif
	material col_mat
	if gs_shadow=0 then
		shadow off, off
	else
		shadow on, on
	endif
return

"set_show_3d":
	success = LIBRARYGLOBAL ("Libraryflobals-km", "show_connect", show_connect)
	show = 0
	if show_connect and upr then show = 1
	if not(upr) then show = 1
	if show then 
		call "Показ_по_типам" PARAMETERS tip_konstr=tip_konstr RETURNED_PARAMETERS show_type
		show = show_type
	endif
	if show then 
		call "Показ_по_группам" PARAMETERS ALL el_views=el_views RETURNED_PARAMETERS show_el
		show = show_el
	endif
	if show then 
		call "Показ_по_сборкам" PARAMETERS ALL subpos=subpos, pos=pos RETURNED_PARAMETERS show_subpos, show_marker
		show = show_subpos
	endif
	if show then
		success = LIBRARYGLOBAL ("Libraryflobals-km", "show_list", show_list)
		show = show_list
	endif
	if show then
		success = LIBRARYGLOBAL ("Libraryflobals-km", "show_izd", show_izd)
		success = LIBRARYGLOBAL ("Libraryflobals-km", "show_metall", show_metall)
		if type_spec = "Металл" and not(show_metall) then show = 0
		if type_spec = "Изделие" and not(show_izd) then show = 0
	endif
	if show then
		success = LIBRARYGLOBAL ("Libraryflobals-km", "ignore_id", ignore_id)
		success = LIBRARYGLOBAL ("Libraryflobals-km", "show_ingore", show_ingore)
		show_spec = 0 : IF STRSTR (GLOB_ID, ignore_id, 1) > 0 or type_spec="Не специфицировать" THEN show_spec = 1
		if not(show_ingore) and show_spec then show = 0
	endif
	success = LIBRARYGLOBAL ("Libraryflobals-km", "show_axsis", show_axsis)
	success = LIBRARYGLOBAL ("Libraryflobals-km", "show_only_axsis", show_only_axsis)
	success = LIBRARYGLOBAL ("Libraryflobals-km", "gs_detlevel_3D", gs_detlevel_3D)
	IF gs_detlevel_3D=`Простой` then
		det_lvl_2d = 1
		det_lvl_3d = 1
		DR_EPS = 0.3
	endif
	IF gs_detlevel_3D=`Детальный` THEN
		det_lvl_2d = 2
		det_lvl_3d = 2
		DR_EPS = 0.01
	endif
	IF gs_detlevel_3D=`Откл` THEN
		det_lvl_2d = 2
		det_lvl_3d = 0
		DR_EPS = 1
	endif
	if show then
		show_if_vert=1 : show_if_gor=1 : show_if_ang=1
		success = LIBRARYGLOBAL ("Libraryflobals-km", "show_if_vert", show_if_vert)
		success = LIBRARYGLOBAL ("Libraryflobals-km", "show_if_gor", show_if_gor)
		success = LIBRARYGLOBAL ("Libraryflobals-km", "show_if_ang", show_if_ang)
		if el_type_view=1 and not(show_if_gor) and show then show = 0
		if el_type_view=2 and not(show_if_vert) and show then show = 0
		if el_type_view=3 and not(show_if_ang) and show then show = 0
	endif
	show_list = 0 : success = LIBRARYGLOBAL ("Libraryflobals-km", "show_list", show_list)
	if strlen(syst_name)>1 then
		success = LIBRARYGLOBAL ("Libraryflobals-mep", "show_op", show_op)
		call "Показ_систем" PARAMETERS All isMep=0, isEqp=1 RETURNED_PARAMETERS show_el
		if show = 1 and show_el < EPS then show = 0
		if show = 1 and show_op < EPS then show = 0
		if show = 1 then CALL "MEP_m_RequestSystemGlobals" PARAMETERS ALL one_ConID=0 returned_parameters gs_cont_pe, sMat, gs_InsMat
	endif
	if type_rifl <> RIFL_NONE then
		matinx = 0
		success = LIBRARYGLOBAL ("Libraryflobals-km", "show_rifl_3d", show_rifl_3d)
		if show_rifl_3d="Подробно" and type_rifl = RIFL_PRESS then
		else
			if show_rifl_3d<>"Нет" and matname <> "" then matinx = ind(material, matname)
			if matinx > 0 then col_mat = matinx
		endif
	endif
return

"get_mat":
	call "macro_get_mat" parameters all, RETURNED_PARAMETERS tcol_mat, tbmat
	if tcol_mat>1 then col_mat = tcol_mat
	if strlen(syst_name)>1 then col_mat = sMat
	if gs_shadow=0 then
		shadow off
	else
		shadow on
	endif
	if strlen(syst_name)>1 then col_mat = sMat
	if matinx > 0 then col_mat = matinx
return
