	i = 1: n=1: j=1 : v0="" : v1=0 : v2=0 : v3=0 : v4=0 : v5=""
	"nxt21":
	if n <> -1 then
		n=INPUT(ch4,i,1,v0,v1,v2,v3,v4,v5,v6)
		if vartype(v0)=2 then
			naen_m_ug[j]=v0
			ves_m_ug[j]=v1
			b_ug[j]=v2/1000
			h_ug[j]=v3/1000
			t_ug[j]=v4/1000
			gost_ug[j]=v5
			j = j + 1
		endif
		i = i + 1
		goto "nxt21"
	else
		close (ch4)
	endif
endif
