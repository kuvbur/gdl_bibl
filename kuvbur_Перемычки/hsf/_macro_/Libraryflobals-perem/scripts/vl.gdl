	dim naen_m_ug[] : naen_m_ug[1] = ""
	dim ves_m_ug[] : ves_m_ug[1] = 0
	dim b_ug[] : b_ug[1] = 0
	dim h_ug[] : h_ug[1] = 0
	dim t_ug[] : t_ug[1] = 0
